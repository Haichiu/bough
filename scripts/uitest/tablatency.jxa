// Edit-field latency probe (poll-only). Usage: osascript -l JavaScript tablatency.jxa <timeoutMs> [keycode]
// Polls MindFlow's canvas window AXFocusedUIElement until it becomes a text editor.
// With a keycode argument it first posts that key via System Events (e.g. 36 = Return,
// the new-model "edit selected node"); without one it just polls (trigger externally).
// Prints MS=<n> (ms after probe start), TIMEOUT before=<role>, or PRE_EDITED.
const se = Application('System Events')
const proc = se.processes.byName('MindFlow')

function canvasWindow() {
  return proc.windows.whose({name: {_contains: ' – '}})[0]
}

function focusedRole() {
  try {
    const w = canvasWindow()
    const el = w.attributes.byName('AXFocusedUIElement').value()
    return String(el.role())
  } catch (e) { return '' }
}

function run(argv) {
  const timeout = parseInt(argv[0] || '8000', 10)
  if (argv[1]) {
    const front = se.applicationProcesses.whose({frontmost: true})[0]
    let frontName = ''
    try { frontName = String(front.name()) } catch (e) {}
    if (frontName !== 'MindFlow') throw new Error('global input blocked: frontmost=' + (frontName || 'unknown'))
    se.keyCode(parseInt(argv[1], 10))
  }
  const before = focusedRole()
  if (before === 'AXTextArea' || before === 'AXTextField') { console.log('PRE_EDITED'); return }
  const t0 = Date.now()
  while (Date.now() - t0 < timeout) {
    const r = focusedRole()
    if (r === 'AXTextArea' || r === 'AXTextField') {
      console.log('MS=' + (Date.now() - t0))
      return
    }
    delay(0.015)
  }
  console.log('TIMEOUT before=' + before)
}
