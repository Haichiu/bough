// Prints the AX role of MindFlow's focused element (empty string if none).
// AXFocusedUIElement belongs to the process, not an individual window.
const se = Application('System Events')
try {
  const proc = se.processes.byName('MindFlow')
  const el = proc.attributes.byName('AXFocusedUIElement').value()
  console.log(String(el.role()))
} catch (e) { console.log('') }
