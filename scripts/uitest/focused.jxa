// Prints the AX role of MindFlow's canvas window focused element (empty string if none).
// Canvas window = the one whose title contains " - " (en-dash form " – ").
const se = Application('System Events')
try {
  const win = se.processes.byName('MindFlow').windows.whose({name: {_contains: ' – '}})[0]
  const el = win.attributes.byName('AXFocusedUIElement').value()
  console.log(String(el.role()))
} catch (e) { console.log('') }
